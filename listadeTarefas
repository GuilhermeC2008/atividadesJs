<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<title>Lista de Tarefas</title>

<style>
body {
  font-family: Arial;
  background: #f4f4f4;
  padding: 20px;
}

.container {
  background: white;
  padding: 20px;
  border-radius: 10px;
  max-width: 400px;
  margin: auto;
}

input, select, button {
  padding: 10px;
  margin: 5px 0;
  width: 100%;
}

li {
  margin-top: 10px;
}
</style>

</head>
<body>

<div class="container">
  <h2>📋 Lista de Tarefas</h2>

  <input id="titulo" placeholder="Digite a tarefa">

  <select id="prioridade">
    <option value="baixa">Baixa</option>
    <option value="alta">Alta</option>
  </select>

  <button onclick="adicionar()">Adicionar</button>

  <ul id="lista"></ul>
</div>

<script>
let tarefas = [];

function adicionar() {
  const titulo = document.getElementById("titulo").value;
  const prioridade = document.getElementById("prioridade").value;

  if (titulo === "") {
    alert("Digite uma tarefa!");
    return;
  }

  const tarefa = { titulo, prioridade };

  if (prioridade === "alta") {
    tarefas.unshift(tarefa); // início
  } else {
    tarefas.push(tarefa); // final
  }

  document.getElementById("titulo").value = "";

  renderizar();
}

function renderizar() {
  const ul = document.getElementById("lista");
  ul.innerHTML = "";

  tarefas.forEach(t => {
    ul.innerHTML += `<li>${t.titulo} - (${t.prioridade})</li>`;
  });
}
</script>

</body>
</html>
