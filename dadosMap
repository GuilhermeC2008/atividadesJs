<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<title>Produtos com Desconto</title>

<style>
body {
  font-family: Arial;
  background: #f4f4f4;
  padding: 20px;
}

.container {
  background: white;
  padding: 20px;
  border-radius: 10px;
  max-width: 400px;
  margin: auto;
}

button {
  padding: 10px;
  width: 100%;
  margin-bottom: 10px;
}

li {
  margin-top: 10px;
}
</style>

</head>
<body>

<div class="container">
  <h2>🛍️ Produtos com 10% de desconto</h2>

  <button onclick="mostrar()">Mostrar produtos</button>

  <ul id="lista"></ul>
</div>

<script>
const produtos = [
  { nome: "Mouse", preco: 50 },
  { nome: "Teclado", preco: 100 },
  { nome: "Monitor", preco: 800 }
];

function mostrar() {
  const lista = document.getElementById("lista");
  lista.innerHTML = "";

  // cria novo array com desconto usando map
  const comDesconto = produtos.map(produto => {
    return {
      nome: produto.nome,
      preco: produto.preco * 0.9
    };
  });

  comDesconto.forEach(p => {
    lista.innerHTML += `<li>${p.nome} - R$ ${p.preco.toFixed(2)}</li>`;
  });
}
</script>

</body>
</html>
